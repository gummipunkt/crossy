<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base XML theme used by the system before Compose draws the first
      frame. The real theming (Material You, dark mode, dynamic color)
      happens in CrossyTheme.kt. We deliberately use the system Material
      parent so we don't have to depend on `com.google.android.material`.
    -->
    <style name="Theme.Crossy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
