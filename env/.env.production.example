# Copy to env/.env.production and fill in every empty value.
# Never reuse the example values below: generate your own secrets.

# Rails
RAILS_ENV=production
RACK_ENV=production
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Public base URL (used for OAuth redirects, mailer links, and public image URLs for Threads)
PUBLIC_BASE_URL=https://crossy.example.com

# Database (PostgreSQL)
# Example if using the compose service `db` (match POSTGRES_* in docker-compose if you override them):
# POSTGRES_USER=crossy
# POSTGRES_PASSWORD=change-me-strong-secret
# POSTGRES_DB=server_production
DATABASE_URL=postgresql://crossy:crossy@db:5432/server_production

# Lockbox / Blind Index: both must be 64 hex characters.
# Generate each with: openssl rand -hex 32
# Keep them safe: losing LOCKBOX_MASTER_KEY makes stored access tokens unreadable.
LOCKBOX_MASTER_KEY=
BLIND_INDEX_MASTER_KEY=

# Threads API (global app credentials for OAuth)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_BASE="https://www.threads.net"
THREADS_GRAPH_BASE="https://graph.threads.net"
# Optional: override the requested OAuth scopes (comma-separated). The default
# also requests threads_manage_insights and threads_read_replies for engagement sync.
# THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_insights,threads_read_replies

# SMTP (outgoing mail for password reset)
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
# login|plain|cram_md5
SMTP_AUTH=login
SMTP_STARTTLS=true
# Optional: none|peer|client_once|fail_if_no_peer_cert
# SMTP_OPENSSL_VERIFY_MODE=

# Mailer sender address (From:)
MAILER_SENDER=crossy@example.com

# Optional: Bluesky PDS used when an account has no custom instance
# BLUESKY_BASE=https://bsky.social

# Optional: extra Content-Security-Policy connect-src origins (comma-separated), e.g. staging API or relay hosts
# CSP_CONNECT_SRC_EXTRA=https://example.com,https://wss.example.com
