<%
  delivery = item.delivery
  post     = delivery.post
  provider = delivery.provider_account.provider
  ts       = event_time(item)

  is_reply = item.is_a?(DeliveryReply)
  kind = is_reply ? "reply" : item.kind

  icon_class, icon_glyph, action_text =
    case kind
    when "reply"  then [ "bg-violet-100 text-violet-700",  "💬", "hat geantwortet" ]
    when "like"   then [ "bg-rose-100 text-rose-700",      "♥",  "hat geliked"     ]
    when "repost" then [ "bg-emerald-100 text-emerald-700", "🔁", "hat reposted"   ]
    end

  display_name = item.author_name.presence || item.author_handle.presence || "Jemand"
%>
<li class="crossy-card flex gap-3 items-start">
  <div class="shrink-0">
    <% if item.author_avatar_url.present? %>
      <img src="<%= item.author_avatar_url %>" alt="" loading="lazy" class="h-10 w-10 rounded-full object-cover border border-stone-200" />
    <% else %>
      <div class="h-10 w-10 rounded-full bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-500 text-sm font-semibold">
        <%= display_name.to_s[0,1].upcase %>
      </div>
    <% end %>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-stone-700">
      <span class="inline-flex items-center justify-center h-5 w-5 rounded-full text-xs <%= icon_class %>" aria-hidden="true"><%= icon_glyph %></span>
      <span class="font-semibold text-stone-900 truncate max-w-[14rem]"><%= display_name %></span>
      <% if item.author_handle.present? && item.author_name.present? %>
        <span class="text-stone-500 text-xs truncate max-w-[10rem]">@<%= item.author_handle %></span>
      <% end %>
      <span class="text-stone-500"><%= action_text %></span>
      <span class="<%= network_badge_class(provider) %>"><%= network_label(provider) %></span>
      <% if ts %>
        <span class="text-[11px] text-stone-400" title="<%= l(ts, format: :long) rescue ts %>">· <%= time_ago_in_words(ts) %> her</span>
      <% end %>
    </div>

    <% if is_reply && item.content.present? %>
      <div class="mt-2 text-sm text-stone-800 whitespace-pre-line break-words rounded-lg bg-violet-50/70 border border-violet-100 px-3 py-2">
        <%= item.content %>
      </div>
    <% end %>

    <div class="mt-2 flex flex-wrap items-center gap-3 text-[12px]">
      <%= link_to "Auf Post anzeigen", post_path(post), class: "crossy-link" %>
      <% if (link = (is_reply ? item.permalink : item.author_url)).present? %>
        <a href="<%= link %>" target="_blank" rel="noopener noreferrer" class="crossy-link">
          <%= is_reply ? "Original ansehen" : "Profil ansehen" %>
        </a>
      <% end %>
      <span class="text-stone-400 truncate">Post #<%= post.id %>: <%= post.content_text.to_s.truncate(60).gsub(/\s+/, " ") %></span>
    </div>
  </div>
</li>
