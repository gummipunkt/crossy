<div class="mb-6">
  <h1 class="crossy-page-title">My posts</h1>
  <p class="mt-1 text-sm text-stone-600">Übersicht deiner versendeten Posts und ihres Status.</p>
</div>

<div class="space-y-5">
  <% @posts.each do |p| %>
    <article class="crossy-card">
      <div class="text-sm flex items-start sm:items-center justify-between gap-2 text-stone-600">
        <span class="font-semibold text-stone-800">Post #<%= p.id %></span>
        <span class="text-xs text-stone-500 shrink-0 tabular-nums"><%= p.created_at.in_time_zone.strftime("%Y-%m-%d %H:%M") %></span>
      </div>
      <% if p.content_warning.present? %>
        <div class="mt-2 text-xs rounded-lg border border-amber-200 bg-amber-50 px-2 py-1.5 text-amber-900">CW: <%= p.content_warning %></div>
      <% end %>
      <div class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-stone-800 break-words"><%= p.content_text %></div>

      <div class="mt-4 flex flex-wrap gap-2">
        <% p.deliveries.each do |d| %>
          <span class="<%= network_badge_class(d.provider_account.provider) %>">
            <%= network_label(d.provider_account.provider) %> · <%= d.status %>
          </span>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-violet-100/60">
        <%= render "shared/engagement_counters",
              like_count: p.total_like_count,
              reply_count: p.total_reply_count,
              repost_count: p.total_repost_count,
              synced_at: p.engagement_last_synced_at %>
        <%= link_to "Details →", post_path(p), class: "crossy-link text-sm" %>
      </div>
    </article>
  <% end %>
</div>
