<div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-4">
  <% deliveries.each do |d| %>
    <% status_class = case d.status.to_s
      when "succeeded" then "border-green-200/90 bg-green-50/80"
      when "failed" then "border-rose-200/90 bg-rose-50/80"
      when "awaiting_signature" then "border-amber-200/90 bg-amber-50/80"
      when "scheduled" then "border-sky-200/90 bg-sky-50/80"
      else "border-violet-100/80 bg-violet-50/70"
      end %>
    <div class="crossy-card-muted <%= status_class %>">
      <div class="flex items-center justify-between gap-2 mb-2">
        <span class="<%= network_badge_class(d.provider_account.provider) %>"><%= network_label(d.provider_account.provider) %></span>
        <span class="inline-flex items-center rounded-full border border-white/60 bg-white/80 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-stone-600">
          <%= d.status %>
        </span>
      </div>

      <% if d.provider_post_id.present? %>
        <div class="text-[11px] text-stone-500 break-all mt-1 font-mono">ID: <%= d.provider_post_id %></div>
      <% end %>
      <% if d.error_message.present? %>
        <div class="text-xs text-rose-900 mt-2 rounded-md bg-rose-50 px-2 py-1.5 border border-rose-100">Error: <%= d.error_message %></div>
      <% end %>
      <% if d.failed? %>
        <%# _top: the button sits inside the deliveries turbo-frame, the redirect is a full page. %>
        <%= button_to "Retry", retry_post_delivery_path(post, d), method: :post,
              form: { data: { turbo_frame: "_top" } },
              class: "mt-2 rounded-lg border border-rose-200 bg-white px-3 py-1.5 text-xs font-semibold text-rose-800 hover:bg-rose-50 transition-colors" %>
      <% end %>

      <% if d.engagement_syncable? || d.metrics_fetched_at.present? %>
        <div class="mt-3 pt-3 border-t border-violet-100/60">
          <%= render "shared/engagement_counters",
                like_count: d.like_count,
                reply_count: d.reply_count,
                repost_count: d.repost_count,
                synced_at: d.metrics_fetched_at,
                error: d.metrics_error %>
        </div>

        <% if d.replies.any? %>
          <%= render partial: "posts/replies", locals: { replies: d.replies } %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
