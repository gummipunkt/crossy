<div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-4">
  <% deliveries.each do |d| %>
    <% status_class = case d.status.to_s
      when "succeeded" then "border-green-200/90 bg-green-50/80"
      when "failed" then "border-rose-200/90 bg-rose-50/80"
      when "awaiting_signature" then "border-amber-200/90 bg-amber-50/80"
      else "border-violet-100/80 bg-violet-50/70"
      end %>
    <div class="crossy-card-muted <%= status_class %>">
      <div class="text-sm font-semibold capitalize text-stone-800 mb-1 flex items-center justify-between gap-2">
        <span><%= d.provider_account.provider %></span>
        <span class="inline-flex items-center rounded-full border border-white/60 bg-white/80 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-stone-600">
          <%= d.status %>
        </span>
      </div>
      <% if d.provider_post_id.present? %>
        <div class="text-xs text-stone-600 break-all mt-1 font-mono">ID: <%= d.provider_post_id %></div>
      <% end %>
      <% if d.error_message.present? %>
        <div class="text-xs text-rose-900 mt-3 rounded-md bg-rose-50 px-2 py-1.5 border border-rose-100">Error: <%= d.error_message %></div>
      <% end %>

      <% if d.engagement_syncable? || d.metrics_fetched_at.present? %>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-stone-700">
          <span class="inline-flex items-center gap-1" title="Likes">
            <span aria-hidden="true">♥</span>
            <span class="font-semibold tabular-nums"><%= d.like_count %></span>
            <span class="sr-only">Likes</span>
          </span>
          <span class="inline-flex items-center gap-1" title="Replies">
            <span aria-hidden="true">💬</span>
            <span class="font-semibold tabular-nums"><%= d.reply_count %></span>
            <span class="sr-only">Replies</span>
          </span>
          <span class="inline-flex items-center gap-1" title="Reposts/Reblogs">
            <span aria-hidden="true">🔁</span>
            <span class="font-semibold tabular-nums"><%= d.repost_count %></span>
            <span class="sr-only">Reposts</span>
          </span>
          <% if d.metrics_fetched_at.present? %>
            <span class="text-[11px] text-stone-500" title="<%= l(d.metrics_fetched_at, format: :long) rescue d.metrics_fetched_at %>">
              · aktualisiert <%= time_ago_in_words(d.metrics_fetched_at) %> her
            </span>
          <% else %>
            <span class="text-[11px] text-stone-500">· wird synchronisiert …</span>
          <% end %>
        </div>
        <% if d.metrics_error.present? %>
          <div class="mt-2 text-[11px] text-amber-900 rounded-md bg-amber-50 px-2 py-1 border border-amber-100" title="<%= d.metrics_error %>">
            Engagement-Sync fehlgeschlagen
          </div>
        <% end %>
        <% if d.replies.any? %>
          <%= render partial: "posts/replies", locals: { replies: d.replies } %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
