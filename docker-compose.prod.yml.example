# Production setup for Crossy.
#
#   cp docker-compose.prod.yml.example docker-compose.yml
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" > .env   # URL-safe characters only
#   cp env/.env.production.example env/.env.production   # fill it in
#   docker compose up -d --build
#
# The app image is built from server/Dockerfile: gems and assets are baked in
# at build time and the app runs as an unprivileged user (uid 1000). `web`
# runs migrations on start (bin/docker-entrypoint); `worker` runs Solid Queue,
# including the recurring jobs (scheduled posts, Threads token refresh).
#
# The app listens on 127.0.0.1:3022 only. Put a TLS-terminating reverse proxy
# (Caddy, nginx, Traefik, ...) in front of it: production forces HTTPS.

x-app: &app
  build: ./server
  image: crossy:latest
  restart: unless-stopped
  env_file:
    - env/.env.production
  environment:
    RAILS_ENV: production
    RAILS_LOG_LEVEL: ${RAILS_LOG_LEVEL:-info}
    DATABASE_URL: postgresql://crossy:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db:5432/server_production
    CACHE_DATABASE_URL: postgresql://crossy:${POSTGRES_PASSWORD}@db:5432/server_production_cache
    QUEUE_DATABASE_URL: postgresql://crossy:${POSTGRES_PASSWORD}@db:5432/server_production_queue
    CABLE_DATABASE_URL: postgresql://crossy:${POSTGRES_PASSWORD}@db:5432/server_production_cable
  volumes:
    # Active Storage uploads; the worker reads them when posting media.
    - storage:/rails/storage
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "5"

services:
  db:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: crossy
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: server_production
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U crossy -d server_production"]
      interval: 5s
      timeout: 5s
      retries: 10

  web:
    <<: *app
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "127.0.0.1:${CROSSY_PORT:-3022}:80"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost/up || exit 1"]
      interval: 10s
      timeout: 5s
      start_period: 60s
      retries: 6

  worker:
    <<: *app
    command: ["./bin/jobs"]
    depends_on:
      db:
        condition: service_healthy
      # web runs db:prepare; start jobs once the schema is in place.
      web:
        condition: service_healthy

volumes:
  db-data:
  storage:
